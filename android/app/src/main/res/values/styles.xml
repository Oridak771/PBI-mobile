<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts; removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cbi_background</item>
    </style>
</resources>
